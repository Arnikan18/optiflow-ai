# Application
APP_ENV=development
APP_VERSION=4.0
SCENARIO_ID=phase2-demo
LOG_LEVEL=INFO

# Frontend
FRONTEND_PORT=3000
FRONTEND_CONTAINER_PORT=3000
VITE_CORE_API_URL=http://localhost:8000

# Core API
CORE_API_PORT=8000
CORE_API_CONTAINER_PORT=8000
CORE_API_HOST=0.0.0.0
CORE_LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONTAINER_PORT=5432
POSTGRES_DB=optiflow
POSTGRES_USER=optiflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://optiflow:change-me@postgres:5432/optiflow

# Enterprise service SQLite databases
CRM_DATABASE_URL=sqlite:////app/data/crm.db
INCIDENT_DATABASE_URL=sqlite:////app/data/incident.db
WORKFORCE_DATABASE_URL=sqlite:////app/data/workforce.db
COMMUNICATION_DATABASE_URL=sqlite:////app/data/communication.db

# Tool Services
CRM_SERVICE_URL=http://crm-service:8101
INCIDENT_SERVICE_URL=http://incident-service:8102
WORKFORCE_SERVICE_URL=http://workforce-service:8103
COMMUNICATION_SERVICE_URL=http://communication-service:8104

CRM_SERVICE_PORT=8101
CRM_SERVICE_CONTAINER_PORT=8101
INCIDENT_SERVICE_PORT=8102
INCIDENT_SERVICE_CONTAINER_PORT=8102
WORKFORCE_SERVICE_PORT=8103
WORKFORCE_SERVICE_CONTAINER_PORT=8103
COMMUNICATION_SERVICE_PORT=8104
COMMUNICATION_SERVICE_CONTAINER_PORT=8104

# Tool authentication
TOOL_SHARED_TOKEN=change-me
ADMIN_API_KEY=change-me-admin

# Tool service standards
ENABLE_SEED_DATA=true
REQUEST_ID_HEADER=X-Request-ID
MAX_REQUEST_ID_LENGTH=128
MAX_PAGE_SIZE=100
RESERVATION_TTL_SECONDS=300
ASSIGNMENT_REQUEST_TTL_SECONDS=900
SIMULATED_DELIVERY_MODE=success

# Tool behaviour
TOOL_TIMEOUT_SECONDS=3
MAX_TOOL_RETRIES=2

# Optimizer
OPTIMIZER_PROVIDER=cp_sat
CP_SAT_TIME_LIMIT_SECONDS=5
CP_SAT_RANDOM_SEED=42
GENERATE_ALL_OPTIMIZATION_PROFILES=true
OPTIMIZER_ALLOW_FALLBACK=false

# Phase 2 demonstration
DEMO_MODE=true
DEMO_DELAY_MS=300
DEMO_PORTFOLIO_TIMEOUT_SECONDS=3
DEMO_HEALTH_TIMEOUT_SECONDS=2
DEMO_ALLOW_FAILURE_INJECTION=true

# Dynamic enterprise simulation
SIMULATION_DEFAULT_SCENARIO=product_release_day
SIMULATION_AUTO_ADVANCE=false
SIMULATION_TIMEZONE=UTC
SIMULATION_EVENT_CALLBACK_URL=
SIMULATION_EVENT_TIMEOUT_SECONDS=3
SIMULATION_MAX_EVENT_RETRIES=2
SIMULATION_SCENARIO_ROOT=scenarios

# SAGA specialist response polling
SAGA_POLL_MAX_ATTEMPTS=5
SAGA_POLL_INTERVAL_SECONDS=1.0


# AI Core & Gemini configuration
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_RETRIES=1
PROMPT_VERSION=4.0
LLM_SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-local-secret

# LLM Selection (gemini or groq)
LLM_PROVIDER=gemini

# Groq Configuration
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.1-8b-instant

